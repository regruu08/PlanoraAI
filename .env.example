# Planora AI - Environment Configuration Example
# Copy to .env.local and fill in values

# Google Gemini API Key (Get free key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Supabase Configuration (Optional - built-in local offline store works out of the box)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
