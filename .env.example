# Planora AI - Environment Configuration Example
# Copy to .env.local and fill in values

# Google Gemini API Key (Get key from Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Optional OpenAI / Compatible API Key (auto-detected if starting with sk-)
# OPENAI_API_KEY=

# Supabase Configuration (Optional - built-in local offline store works out of the box)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
